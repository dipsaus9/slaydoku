    "pack": "bun tools/pack.ts",
    "validate:generation": "bun tools/validate.ts",
    "schedule": "bun tools/schedule.ts",
    "schedule:check": "bun tools/schedule-check.ts",
    "schedule:next": "bun tools/schedule-next.ts",
    "indexing": "bun tools/indexing.ts",
    "check:share": "bun tools/check-share.ts"
